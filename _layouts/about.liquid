---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="homepage-hero">
  <div class="container">
    <div class="homepage-hero__inner">
      <div class="homepage-hero__header">
        <h1 class="homepage-hero__title">{{ page.subtitle }}</h1>
      </div>

      <div class="homepage-hero__window">
        {% if page.hero_video %}
          <video
            class="homepage-hero__media js-hero-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            {% if page.hero_image %}poster="{{ page.hero_image | relative_url }}"{% endif %}
          >
            <source src="{{ page.hero_video | relative_url }}" type="video/mp4">
            {% comment %} Fallback for browsers that can't play the video {% endcomment %}
            {% if page.hero_image %}
              <img class="homepage-hero__media" src="{{ page.hero_image | relative_url }}" alt="{{ site.title }}">
            {% endif %}
          </video>
        {% elsif page.hero_image %}
          <img
            class="homepage-hero__media"
            src="{{ page.hero_image | relative_url }}"
            alt="{{ site.title }}"
            loading="eager"
          >
        {% endif %}
      </div>

      {% if page.social %}
        <div class="homepage-hero__social">
          <div class="social">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="post homepage homepage-post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
  </header>

  <article class="large homepage">
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.news and site.announcements.enabled %}
      <hr>
      <h2>Announcements</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    {% if page.selected_papers %}
      <hr>
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Recent Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.sponsors %}
      <hr>
      {% comment %}<h2>Sponsors</h2>{% endcomment %}
      {% include sponsors.liquid %}
    {% endif %}
  </article>
</div>

{% if page.hero_video %}
<script>
  /* Respect prefers-reduced-motion: don't autoplay the hero reel; hold the poster. */
  (function () {
    var video = document.querySelector('.js-hero-video');
    if (!video || !window.matchMedia) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.addEventListener('loadedmetadata', function () { video.pause(); });
      video.pause();
    }
  })();
</script>
{% endif %}