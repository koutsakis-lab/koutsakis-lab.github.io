{% comment %}
  Homepage sponsor / collaborator grid.

  Logos, order, links, and current/past status live in _data/sponsors.yml.
  Logos sit directly on the page background; a sponsor with `logo_dark` gets a
  second <img> that swaps in under the dark theme (see .sponsors__img--dark).
{% endcomment %}

<section class="sponsors" aria-label="Sponsors and collaborators">
  <h2 class="sponsors__heading">Sponsors</h2>
  <p class="sponsors__note">Our work is supported by</p>

  <div class="sponsors__grid">
    {% for sponsor in site.data.sponsors %}
      {% assign logo_url = sponsor.logo | prepend: '/assets/img/logos/' | relative_url %}
      <div class="sponsors__item">
        {% if sponsor.url %}<a href="{{ sponsor.url }}" title="{{ sponsor.name | escape }}">{% endif %}
        <img class="sponsors__img{% if sponsor.logo_dark %} sponsors__img--light{% endif %}" src="{{ logo_url }}" alt="{{ sponsor.name | escape }}" title="{{ sponsor.name | escape }}" loading="eager">
        {% if sponsor.logo_dark %}
          {% assign logo_dark_url = sponsor.logo_dark | prepend: '/assets/img/logos/' | relative_url %}
          <img class="sponsors__img sponsors__img--dark" src="{{ logo_dark_url }}" alt="{{ sponsor.name | escape }}" title="{{ sponsor.name | escape }}" loading="eager">
        {% endif %}
        {% if sponsor.url %}</a>{% endif %}
      </div>
    {% endfor %}
  </div>
</section>
