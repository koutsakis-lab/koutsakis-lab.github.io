<li>
  <div class="row">
    <div class="col-sm-10">
      <div class="title">
        {{ item.title }}
      </div>
      <div class="links">
        <a class="abstract btn btn-sm z-depth-0" role="button">Description</a>
        {% if item.catalog %}
          <a href="{{ item.catalog }}" class="btn btn-sm z-depth-0" role="button" rel="external nofollow noopener" target="_blank">UNM Catalog</a>
        {% endif %}
        {% if item.syllabus %}
          <a href="{{ item.syllabus | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button" rel="external nofollow noopener" target="_blank">Syllabus</a>
        {% endif %}
      </div>
      <div class="abstract hidden">
        {{ item.content }}
      </div>
    </div>
  </div>
</li>
